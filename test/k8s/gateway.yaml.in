apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: ${gateway}
spec:
  gatewayClassName: weiche
  addresses: ${addresses}
  listeners:
    - name: web
      protocol: HTTP
      port: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ${gateway}
spec:
  parentRefs: [{name: ${gateway}}]
  hostnames: [${gateway}.example.test]
  rules:
    - backendRefs: [{name: echo, port: 8080}]
